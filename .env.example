# Copy to .env in the backend working directory and fill in your credentials.
# Spring Boot loads .env at startup. Use KEY=value without quotes.
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
SPOTIFY_ENABLED=true
SPOTIFY_MARKET=US
SPOTIFY_REQUEST_TIMEOUT=1500ms
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_REQUEST_TIMEOUT=1200ms
MUSICBRAINZ_USER_AGENT=Ninefold/1.0.0 (mailto:your-email@example.com)
SEARCH_REQUEST_TIMEOUT=2s
SEARCH_FAILURE_COOLDOWN=30s
# Optional catalogs: enable only after adding working credentials.
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_REQUEST_TIMEOUT=1500ms
SOUNDCLOUD_ENABLED=false
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REQUEST_TIMEOUT=1500ms
